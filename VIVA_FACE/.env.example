DATABASE_URL=sqlite+aiosqlite:///./viva_face.db
SECRET_KEY=change-me-in-production-32chars-min

# GPU / InsightFace
DEVICE=cuda
MODEL_NAME=buffalo_l
MODEL_ROOT=models
FACE_THRESHOLD=0.8
MIN_ENROLL_PHOTOS=6

# Open-Meteo (CDMX default)
WEATHER_LAT=19.4326
WEATHER_LON=-99.1332

# Servidor
HOST=0.0.0.0
PORT=8010
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reverse image providers
YANDEX_ENABLED=true
BRIGHTDATA_ENABLED=false
BRIGHTDATA_API_KEY=
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=33335
BRIGHTDATA_SELENIUM_PORT=9515
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch
BING_VISUAL_SEARCH_KEY=tu_clave
