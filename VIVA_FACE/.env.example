DATABASE_URL=sqlite+aiosqlite:///./viva_face.db
SECRET_KEY=change-me-in-production-32chars-min

# GPU / InsightFace
DEVICE=cuda
MODEL_NAME=buffalo_l
MODEL_ROOT=models
FACE_THRESHOLD=0.8
MIN_ENROLL_PHOTOS=6

# Open-Meteo (CDMX default)
WEATHER_LAT=19.4326
WEATHER_LON=-99.1332

# Servidor
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
